# DATABASE_URL — 仅用于本地或 CI 临时 Postgres，禁止填写生产数据库。
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# PORT — Hono 本地开发监听端口。
PORT=<api-port>

# SESSION_SECRET — 至少 32 个字符，仅用于签发 HttpOnly 演示会话，禁止提交真实值。
SESSION_SECRET=<replace-with-a-random-secret-of-at-least-32-characters>

# REPAIR_IMAGE_STORAGE_DIR — 生产必须指向多实例共享、持久化且非公开服务的私有卷；本地可留空使用系统临时目录。
REPAIR_IMAGE_STORAGE_DIR=<absolute-path-to-private-shared-persistent-volume>

# JINGSHU_API_ORIGIN — Web 服务端同源转发到 Hono 的内部地址。
JINGSHU_API_ORIGIN=http://127.0.0.1:<api-port>

# PUBLIC_ORIGIN — 浏览器访问 Web 的唯一同源地址，用于写请求 Origin 校验。
PUBLIC_ORIGIN=http://127.0.0.1:<web-port>
