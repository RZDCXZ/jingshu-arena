# DATABASE_URL — 仅用于本地或 CI 临时 Postgres，禁止填写生产数据库。
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# PORT — Hono 本地开发监听端口。
PORT=<api-port>

# JINGSHU_API_HOST — `pnpm dev` 下 API 的监听地址；局域网调试通常保持 127.0.0.1，由 Web 同源代理访问。
JINGSHU_API_HOST=<api-host>

# JINGSHU_WEB_HOST — Next.js Web 的监听地址；`pnpm dev` 默认使用 0.0.0.0 供同一局域网访问。
JINGSHU_WEB_HOST=<web-host>

# JINGSHU_DEV_ACCESS_HOST — 可选；仅在自动选择了错误网卡时填写手机能访问的电脑主机名或局域网 IP。
JINGSHU_DEV_ACCESS_HOST=<computer-lan-ip-or-hostname>

# SESSION_SECRET — 至少 32 个字符，仅用于签发 HttpOnly 演示会话，禁止提交真实值。
SESSION_SECRET=<replace-with-a-random-secret-of-at-least-32-characters>

# REPAIR_IMAGE_STORAGE_DIR — 生产必须指向多实例共享、持久化且非公开服务的私有卷；本地可留空使用系统临时目录。
REPAIR_IMAGE_STORAGE_DIR=<absolute-path-to-private-shared-persistent-volume>

# JINGSHU_API_ORIGIN — Web 服务端同源转发到 Hono 的内部地址。
JINGSHU_API_ORIGIN=http://127.0.0.1:<api-port>

# PUBLIC_ORIGIN — 浏览器访问 Web 的主要同源地址；本地启动器会额外加入精确的回环和自动探测局域网 Origin。
PUBLIC_ORIGIN=http://127.0.0.1:<web-port>
