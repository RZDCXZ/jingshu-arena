{
  "name": "jingshu-arena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.18.0",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "build:api": "pnpm --filter @jingshu/api build",
    "build:miniprogram": "pnpm --filter @jingshu/miniprogram build",
    "build:web": "pnpm --filter @jingshu/web... build",
    "check:sensitive": "node scripts/check-sensitive-data.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint . && pnpm check:workspace",
    "preinstall": "node scripts/check-toolchain.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "test": "pnpm test:unit && pnpm test:contracts && pnpm test:postgres && pnpm test:seed && pnpm test:design-baseline && pnpm test:e2e",
    "test:contracts": "vitest run --config vitest.contract.config.ts --passWithNoTests",
    "test:design-baseline": "node --test product-ui/tests/content-baseline.test.mjs",
    "test:e2e": "pnpm --filter @jingshu/contracts build && playwright test",
    "test:postgres": "pnpm --filter @jingshu/database test:postgres",
    "test:seed": "vitest run --config vitest.seed.config.ts --passWithNoTests",
    "test:unit": "vitest run --config vitest.unit.config.ts && node --test scripts/dev.test.mjs",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "verify": "pnpm check:toolchain && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:sensitive && pnpm security:audit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
