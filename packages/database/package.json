{
  "name": "@jingshu/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@jingshu/contracts": "workspace:*",
    "@jingshu/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
