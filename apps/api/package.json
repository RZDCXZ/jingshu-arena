{
  "name": "@jingshu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@jingshu/contracts": "workspace:*",
    "@jingshu/database": "workspace:*",
    "@jingshu/domain": "workspace:*",
    "hono": "4.13.1"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json --noEmit false",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test:unit": "vitest run src --exclude '**/*.integration.test.ts'",
    "typecheck": "tsc --project tsconfig.json"
  }
}
